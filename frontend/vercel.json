{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tasknest-nooh.onrender.com/api/:path*"
    },
    {
      "source": "/tasks",
      "destination": "https://tasknest-nooh.onrender.com/tasks"
    },
    {
      "source": "/tasks/:path*",
      "destination": "https://tasknest-nooh.onrender.com/tasks/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
