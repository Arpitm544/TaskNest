# Supabase: copy a direct or Session pooler URI from the project's Connect dialog.
# The Session pooler supports IPv4 hosts. URI-encode password special characters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
PORT=8080
GIN_MODE=debug
PRODUCTION_DOMAIN=

# Backend-only credentials. Never put the secret key in a VITE_* variable.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=tasknest-uploads

# Optional integrations (existing Google sign-in and AI features).
FIREBASE_SERVICE_ACCOUNT_JSON=
GROQ_API_KEY=


# Groq model for task AI features.
GROQ_MODEL=openai/gpt-oss-20b
